cff-version: 1.2.0
message: >-
  If you use AlgoPlasma in your research, please cite the SoftwareX paper below.

# Recommended citation: SoftwareX paper
preferred-citation:
  type: article
  title: "AlgoPlasma: Open algorithms for plasma modeling"
  journal: SoftwareX
  volume: 36
  start: 103176
  year: 2026
  doi: "10.1016/j.softx.2026.103176"
