@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@G02_MCC_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@G02_MCC_ENABLE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
    if(@G02_MCC_ENABLE_FORTRAN@ AND CMAKE_Fortran_COMPILER_LOADED)
        find_dependency(MPI COMPONENTS Fortran)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/G02MCCTargets.cmake")
